---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION } from '../consts';
import { Picture } from 'astro:assets';
import { getIrlImage, responsiveWidths } from '../utils/irlImages';

type Props = CollectionEntry<'irl'>['data'];

const { title, finishDate, heroImg, otherImgs } = Astro.props;

const slug = Astro.url.pathname.split('/').filter(Boolean).at(-1);

if (!slug) {
	throw new Error('Could not determine the IRL project slug');
}

const buildImage = (img: { src: string; alt: string; caption?: string }) => {
	const source = getIrlImage(slug, img.src);

	return {
		...img,
		source,
		widths: responsiveWidths(source, [400, 756, 1512]),
	};
};

const heroImage = buildImage(heroImg);
const otherImages = otherImgs ? otherImgs.map((img) => buildImage(img)) : [];
---

<html lang="en">
	<head>
		<BaseHead title={title} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				max-width: 756px;
				margin: 0 auto;
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
			}
			.prose {
				width: 720px;
				max-width: 100%;
				margin: auto;
				color: var(--color-text);
			}
			.title {
				padding: 0 0 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
			}
			.last-updated-on {
				font-style: italic;
			}
			.extra-image {
				max-width: 756px;
				width: 100%;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="px-2 pb-2 sm:px-4 sm:pb-4 flex flex-col gap-4">
					<div class="title">
						<div class="date">
							<FormattedDate date={finishDate} />
						</div>
						<h1 class="text-5xl">{title}</h1>
						<hr />
					</div>
					<div class="shadow-md hero-image mb-8">
						<Picture
							src={heroImage.source}
							alt={heroImage.alt}
							formats={['avif', 'webp']}
							fallbackFormat="jpg"
							width={heroImage.widths.at(-1)}
							widths={heroImage.widths}
							sizes="(max-width: 756px) calc(100vw - 1rem), 756px"
							loading="eager"
							fetchpriority="high"
						/>
						{heroImage.caption ? (
							<p class="mt-2 mb-0 text-center">{heroImage.caption}</p>
						) : (
							''
						)}
					</div>
					<div class="prose">
						<slot is:raw />
					</div>
					<div class="flex flex-col gap-8 items-center">
						{
							otherImages.map((img) => (
								<div class="extra-image">
									<Picture
										src={img.source}
										alt={img.alt}
										formats={['avif', 'webp']}
										fallbackFormat="jpg"
										width={img.widths.at(-1)}
										widths={img.widths}
										sizes="(max-width: 756px) calc(100vw - 1rem), 756px"
										loading="lazy"
									/>
									{img.caption ? (
										<p class="mt-2 mb-0 text-center">{img.caption}</p>
									) : (
										''
									)}
								</div>
							))
						}
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
